# Template for /etc/plimsoll/production.env (chmod 600, owned by the deploy user).
# Copy to /etc/plimsoll/production.env and fill in real values. Never commit the copy.
#
# Generate the two secrets on the server, both URL-safe hex so they need no escaping:
#   openssl rand -hex 24   # -> POSTGRES_PASSWORD
#   openssl rand -hex 32   # -> PLIMSOLL_SECRET_KEY

POSTGRES_DB=plimsoll
POSTGRES_USER=plimsoll
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24

# Exact browser origin, no trailing slash. IP or DNS name, matching the certificate:
#   PLIMSOLL_ALLOWED_ORIGINS=https://119.91.211.156
#   PLIMSOLL_ALLOWED_ORIGINS=https://plimsoll.example.com
PLIMSOLL_ALLOWED_ORIGINS=https://119.91.211.156

PLIMSOLL_SECRET_KEY=replace-with-openssl-rand-hex-32

# Not set anywhere in production: PLIMSOLL_LOCAL_HTTP, PLIMSOLL_LOCAL_MAIL_TEST and any
# PLIMSOLL_SMTP_* value. Anonymous workspaces send no mail.
